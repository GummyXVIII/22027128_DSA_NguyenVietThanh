
#include <iostream>
using namespace std;

class QueueLinkedList {
private:
    struct Node {
        int data;
        Node* next;

        Node(int x) {
            data = x;
            next = NULL;
        }
    };

    Node* frontNode;
    Node* rearNode;

public:
    QueueLinkedList() {
        frontNode = rearNode = NULL;
    }

    ~QueueLinkedList() {
        while (frontNode != NULL) {
            Node* temp = frontNode;
            frontNode = frontNode->next;
            delete temp;
        }
    }

    bool isEmpty() {
        return frontNode == NULL;
    }

    void enqueue(int x) {
        Node* p = new Node(x);

        if (isEmpty()) {
            frontNode = rearNode = p;
        } else {
            rearNode->next = p;
            rearNode = p;
        }
    }

    bool dequeue() {
        if (isEmpty()) return false;

        Node* temp = frontNode;
        frontNode = frontNode->next;
        delete temp;

        if (frontNode == NULL)
            rearNode = NULL;

        return true;
    }

    bool front(int &x) {
        if (isEmpty()) return false;

        x = frontNode->data;
        return true;
    }

    void display() {
        Node* p = frontNode;
        cout << "Front -> ";
        while (p != NULL) {
            cout << p->data << " ";
            p = p->next;
        }
        cout << "<- Rear" << endl;
    }
};
